# ============================================================
# .env.example — chumon-hub 環境変数テンプレート
# ============================================================
# 【Dev Container + 1Password を使う場合（推奨）】
#   このファイルをコピーして .env.local を作り、各値を「実値ではなく op:// 参照」で記述する。
#   .env.local は .gitignore 済みでコミットされない。`pnpm dev` が op run で実行時に解決する。
#   例:
#     GOOGLE_API_KEY=op://<Vault>/<Item>/<Field>
#     API_SECRET=op://<Vault>/<Item>/<Field>
#   前提: ホスト環境に OP_SERVICE_ACCOUNT_TOKEN を設定（devcontainer.json が転送）。
#         トークンは 1Password のサービスアカウント（dev 用 Vault に最小権限）で発行する。
#
# 【op を使わない場合】
#   .env.local に下記キーへ実値を直接記述する（その .env.local は絶対にコミットしない）。
# ============================================================

# --- Google Gemini API ---
# Google AI Studio (https://aistudio.google.com/) で取得したAPIキー
# 必須
GOOGLE_API_KEY=your_google_api_key_here

# サービスアカウントを使用する場合のみ設定（通常はAPI_KEYがあれば不要）
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# --- Cloudflare Zero Trust (Access) ---
# Cloudflare Accessのポリシー設定で使用するTeam Domain (例: my-team)
# 開発環境(NODE_ENV=development)では認証チェックはスキップされますが、設定自体は推奨されます
# 必須
CLOUDFLARE_TEAM_DOMAIN=your-team-domain

# Cloudflare AccessのアプリケーションAudience Tag (AUD)
# Cloudflare Zero Trust ダッシュボード > Access > Applications > Overview から確認可能
# 必須
CLOUDFLARE_AUDIENCE=your_cloudflare_audience_tag

# --- Application Secrets ---
# アプリケーション内部でトークンの暗号化などに使用する秘密鍵
# 以下のコマンドで生成したランダムな32バイト(64文字)の16進数文字列を設定してください
# 生成コマンド: openssl rand -hex 32
# 必須
API_SECRET=your_generated_random_secret_here

# --- Optional / Local Development ---
# 開発モードの明示（Next.jsでは通常 `next dev` 時に自動で development になります）
# NODE_ENV=development

# --- 評価ハーネス（任意 / 手動実行のみ・CIでは使わない） ---
# 図面抽出の評価ハーネス（scripts/eval/*）が参照する。
# GOLDEN_SET_DIR: private repo `chumon-hub-golden` のローカル clone パス（labels.json と pdf/ を含む）
# GOLDEN_SET_DIR=/path/to/chumon-hub-golden
# EVAL_OUTPUT_DIR: 結果 JSON の出力先。省略時は <GOLDEN_SET_DIR>/results
# EVAL_OUTPUT_DIR=/path/to/chumon-hub-golden/results