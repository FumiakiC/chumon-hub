      "type": "string",
      "description": "Quotation Number (見積No)"
    },
    "totalAmount": {
      "type": "string",
      "description": "Total Amount (合計金額)"
    },
    "requestedDeliveryDate": {
      "type": "string",
      "description": "Requested/Confirmed Delivery Date (請納期/納入期日) - Extract '納入期日' or '納期' here. Format as YYYYMMDD (e.g., 20251114). Do NOT use slashes or other separators."
    },
