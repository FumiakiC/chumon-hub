      "type": "string",
      "description": "Payment Terms (支払条件)"
    },
    "deliveryLocation": {
      "type": "string",
      "description": "Delivery Location (受渡場所) - Do NOT infer from the recipient's address or company name. If '受渡場所' is not explicitly labeled, return an empty string."
    },
