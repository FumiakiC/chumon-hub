exports[`toResponseJsonSchema > 'drawingSchema' の Gemini 入力を固定する 1`] = `
"{
  "type": "object",
  "properties": {
    "reasoning": {
      "type": "string",
      "description": "抽出の思考プロセス。まず図面全体（特に右下の表題欄）を確認し、「数量の特定（表題欄の周囲の余白を走査して項目名を持たない単独の数字を探したか、四角囲み数字を除外したか）」「材質・表面処理の有無」について、どのように判断したかステップバイステップで言語化してください。"
    },
    "drawingNo": {
      "type": "string",
      "description": "Drawing Number (図面番号)"
    },
    "partName": {
      "type": "string",
      "description": "Part/Item Name (品名・部品名)"
    },
    "material": {
      "type": "string",
      "description": "Material (材質) ※材質欄の明確な記載（SS400、SUS、S45C、SUS304（片面ミガキ鋼板 t2）など）を、括弧書きの補足（板厚・仕上げ等）も含めて記載どおりに抽出すること。SOB は表面処理であり材質ではない。記載がない場合は必ず空文字(\\"\\")にすること。人名や日付を誤って入れないこと。"
    },
    "quantity": {
      "description": "数量。『数量』や『QTY』という項目名はありません。項目名も単位も伴わず、単独で書かれた整数が数量です。多くは表題欄の外側、右端の『粗サ』欄の上方の余白にありますが、位置は図面によって異なります。そこに無い場合は、表題欄の上辺沿いの余白や右上を含め、表題欄の周囲を走査して、罫線で囲まれず項目名を持たない数字を探してください。粗さ記号（▽、√、Ra など）が記入されているかどうかに関わらず走査すること。「1」のような1桁の数字が細い線で書かれていることが多く、見落としやすい点に注意してください。図面番号の横などにある四角で囲まれた数字（用紙サイズ等の記号）は絶対に数量として抽出しないこと。該当する数字が見つからない場合は null を出力し、項目名のある欄の数字（尺度の 1:1、日付、公差値、図番の一部など）で代用しないこと。",
      "type": [
        "number",
        "null"
      ]
    },
    "surfaceTreatment": {
      "description": "Surface Treatment (表面処理) ※明確な記載（SOB、めっき、塗装、アルマイト、無電解ニッケル、四三酸化鉄皮膜など）のみ抽出すること。記載がない場合は必ず空文字(\\"\\")にすること。人名や日付を誤って入れないこと。",
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "description": "Confidence level (0-100)"
    }
  },
  "required": [
    "reasoning",
    "drawingNo",
    "partName",
    "material",
    "quantity",
    "confidence"
  ],
  "additionalProperties": false
}"
`;

exports[`toResponseJsonSchema > 'orderSchema' の Gemini 入力を固定する 1`] = `
"{
